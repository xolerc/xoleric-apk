<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center|top"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/widget_bg">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="💬 XOLERIC"
        android:textSize="12sp"
        android:textColor="#818cf8"
        android:textStyle="bold"
        android:fontFamily="sans-serif"
        android:letterSpacing="0.03" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="10dp"
        android:divider="@android:color/transparent"
        android:dividerHeight="6dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📢 Umumiy: So'nggi xabar..."
            android:textSize="11dp"
            android:textColor="rgba(255,255,255,0.4)"
            android:fontFamily="sans-serif"
            android:lines="1"
            android:ellipsize="end" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="👥 Guruh: Xabar..."
            android:textSize="11dp"
            android:textColor="rgba(255,255,255,0.3)"
            android:fontFamily="sans-serif"
            android:lines="1"
            android:ellipsize="end" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="💬 Shaxsiy: ..."
            android:textSize="11dp"
            android:textColor="rgba(255,255,255,0.25)"
            android:fontFamily="sans-serif"
            android:lines="1"
            android:ellipsize="end" />

    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:text="XOLERIC ∞"
        android:textSize="9sp"
        android:textColor="rgba(255,255,255,0.1)"
        android:fontFamily="sans-serif"
        android:gravity="bottom" />

</LinearLayout>
